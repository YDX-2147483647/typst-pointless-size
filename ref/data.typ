  let data = ()

  let current = none
  for line in raw.split(regex("\r?\n")) {
    if line == "" or line.starts-with("# ") {
      continue
    }

    if line.match(key-pattern) != none {
      if current != none {
        data.push((current.key, current.value))
      }
      current = (
        key: line.replace(key-pattern, m => m.captures.first()),
        value: (),
      )
    } else {
      assert.ne(current, none)
      current.value.push(line)
    }
  }
  if current != none {
    data.push((current.key, current.value))
  }

  data
    .map(((key, value)) => (
      key,
      value.map(line => {
        let (g, p) = line.split(",")
        (normalize-g(g), float(p))
      }),
    ))
    .to-dict()
}
